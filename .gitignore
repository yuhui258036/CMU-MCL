# Focused repository: only the CMUmcl client source and docs are tracked.
/*
!/.gitignore
!/LICENSE
!/NOTICE
!/CMUmcl/
!/CMUmcl.Updater/
!/tests/
!/docs/

# CMUmcl build outputs and IDE files
/CMUmcl/bin/
/CMUmcl/obj/
/CMUmcl/.vs/
/CMUmcl/*.user
/CMUmcl/**/*.user
/CMUmcl.Updater/bin/
/CMUmcl.Updater/obj/
/CMUmcl.Updater/*.user
/tests/*
!/tests/LauncherUpdate.Tests/
!/tests/LauncherUpdate.UiAcceptance/
/tests/LauncherUpdate.Tests/bin/
/tests/LauncherUpdate.Tests/obj/
/tests/LauncherUpdate.UiAcceptance/bin/
/tests/LauncherUpdate.UiAcceptance/obj/

# Editor/R history artifacts
**/.Rhistory
**/.RData
**/.Ruserdata
