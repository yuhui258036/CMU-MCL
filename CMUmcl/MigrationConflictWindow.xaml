<Window x:Class="CMUmcl.MigrationConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Foreground="{DynamicResource TextBrush}"
        Title="处理名称冲突"
        Icon="/Assets/CMUmcl.ico"
        Width="760" Height="600" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackdropBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>

        <!-- ============ Buttons ============ -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Border x:Name="overlay" Background="Transparent" CornerRadius="6" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="overlay" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="overlay" Property="Background" Value="#26000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CloseIconButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Content" Value="&#xE711;" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PanelBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PanelBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ TextBox ============ -->
        <Style x:Key="DialogTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}" />

        <!-- ============ Layout / typography ============ -->
        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="RowError" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="处理名称冲突" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="以下实例的目标文件夹名或显示名称与已有实例冲突，可直接编辑后继续迁移。"
                               FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource CloseIconButton}" Click="CloseButton_Click" />
            </Grid>
        </Border>

        <!-- ===================== Body ===================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ConflictsList" Margin="24,18,24,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding SourceDisplayName}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Hint}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="目标文件夹名" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                                <TextBox Text="{Binding TargetName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DialogTextBox}" />
                                <TextBlock Text="{Binding TargetError}" Style="{StaticResource RowError}"
                                           Visibility="{Binding HasTargetError, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="显示名称" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DialogTextBox}" />
                                <TextBlock Text="{Binding DisplayError}" Style="{StaticResource RowError}"
                                           Visibility="{Binding HasDisplayError, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===================== Footer ===================== -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ErrorText" Grid.Row="0" Text="" Foreground="{DynamicResource ErrorBrush}"
                           FontSize="13" TextWrapping="Wrap" MinHeight="18" Margin="0,0,0,8" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource DialogButton}"
                            MinWidth="96" Margin="0,0,10,0" Click="CancelButton_Click" />
                    <Button x:Name="OkButton" Content="继续迁移" Style="{StaticResource DialogPrimaryButton}"
                            MinWidth="128" Click="OkButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
