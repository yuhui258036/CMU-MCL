<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable><LangVersion>latest</LangVersion><AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages><AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects><GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CMUmcl</RootNamespace>
    <AssemblyName>CMUmcl</AssemblyName>
    <ApplicationIcon>Assets\CMUmcl.ico</ApplicationIcon>
    <Version>0.3.48.16</Version><PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Authors>CMUmcl</Authors>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup><ProjectReference Include="../CMUmcl.Updater/CMUmcl.Updater.csproj" ReferenceOutputAssembly="false" /></ItemGroup>
  <ItemGroup>

    <Reference Include="System.Net.Http" /><Reference Include="Microsoft.VisualBasic" /><Reference Include="System.IO.Compression" /><Reference Include="System.IO.Compression.FileSystem" />
    <PackageReference Include="CmlLib.Core" Version="4.1.0" />
    <PackageReference Include="Imazen.WebP" Version="11.0.0" />
    <PackageReference Include="Imazen.WebP.NativeRuntime.win-x64" Version="1.6.1" />
    <PackageReference Include="CmlLib.Core.Installer.NeoForge" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Native\win-x64\vcruntime140.dll" Link="vcruntime140.dll" TargetPath="vcruntime140.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\authlib-injector.jar" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\InstanceIcons\*.png" />
    <Resource Include="Assets\InstanceIcons\*.jpg" />
    <Resource Include="Assets\CMUmcl.ico" />
    <Resource Include="Assets\CMUmcl-icon.png" />
    <Resource Include="Assets\Easter\skin-site-unbreakable.jpg" />
  </ItemGroup>

  <ItemGroup Condition="'$(CMUMCL_CF_PRIVATE_BUILD_ROOT)' != '' and '$(CMUMCL_CF_BUILD_RESOURCE)' != ''">
    <EmbeddedResource Include="$(CMUMCL_CF_BUILD_RESOURCE)" LogicalName="CMUmcl.CurseForge.ProjectKey" />
  </ItemGroup>
  <Target Name="ValidateCurseForgeInjection" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(CMUMCL_CF_BUILD_RESOURCE)' != '' and '$(CMUMCL_CF_PRIVATE_BUILD_ROOT)' == ''"
           Text="CurseForge injection requires an isolated private build root." />
    <Error Condition="'$(CMUMCL_CF_PRIVATE_BUILD_ROOT)' != '' and ('$(CMUMCL_CF_BUILD_RESOURCE)' == '' or !Exists('$(CMUMCL_CF_BUILD_RESOURCE)'))"
           Text="The private build resource is unavailable." />
  </Target>

  <Target Name="CopyUpdaterForBuild" AfterTargets="Build" Condition="'$(SkipUpdaterBuildCopy)' != 'true'">
    <PropertyGroup>
      <UpdaterOutputRoot>$(MSBuildProjectDirectory)\..\CMUmcl.Updater\bin\$(Configuration)\net48\</UpdaterOutputRoot>
    </PropertyGroup>
    <ItemGroup>
      <UpdaterBuildFiles Include="$(UpdaterOutputRoot)**\*" Exclude="$(UpdaterOutputRoot)publish\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterBuildFiles)" DestinationFiles="@(UpdaterBuildFiles->'$(OutDir)updater\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="PublishIndependentUpdater" AfterTargets="Publish">
    <MSBuild Projects="..\CMUmcl.Updater\CMUmcl.Updater.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)updater\'));PublishSingleFile=false" />
  </Target>
<ItemGroup></ItemGroup><ItemGroup><None Update="Licenses/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup></Project>
