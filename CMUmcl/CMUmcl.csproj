<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CMUmcl</RootNamespace>
    <AssemblyName>CMUmcl</AssemblyName>
    <ApplicationIcon>Assets\CMUmcl.ico</ApplicationIcon>
    <Version>0.3.1</Version>
    <Authors>CMUmcl</Authors>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CMUmcl.Updater\CMUmcl.Updater.csproj" ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" AdditionalProperties="TargetFramework=$(TargetFramework)" />
    <PackageReference Include="CmlLib.Core" Version="4.1.0" />
    <PackageReference Include="CmlLib.Core.Installer.NeoForge" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\authlib-injector.jar" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Licenses\Lucide.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\InstanceIcons\*.png" />
    <Resource Include="Assets\InstanceIcons\*.jpg" />
    <Resource Include="Assets\CMUmcl.ico" />
    <Resource Include="Assets\CMUmcl-icon.png" />
  </ItemGroup>

  <Target Name="CopyUpdaterForBuild" AfterTargets="Build" Condition="'$(SkipUpdaterBuildCopy)' != 'true'">
    <PropertyGroup>
      <UpdaterOutputRoot>..\CMUmcl.Updater\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</UpdaterOutputRoot>
    </PropertyGroup>
    <ItemGroup>
      <UpdaterBuildFiles Include="$(UpdaterOutputRoot)**\*" Exclude="$(UpdaterOutputRoot)publish\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterBuildFiles)" DestinationFiles="@(UpdaterBuildFiles->'$(OutDir)updater\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="PublishIndependentUpdater" AfterTargets="Publish">
    <MSBuild Projects="..\CMUmcl.Updater\CMUmcl.Updater.csproj" Targets="Publish"
             RemoveProperties="PublishProfile"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)updater\'));PublishSingleFile=false;DebugType=$(DebugType);DebugSymbols=$(DebugSymbols);CopyOutputSymbolsToPublishDirectory=$(CopyOutputSymbolsToPublishDirectory)" />
  </Target>
</Project>
