<Window x:Class="CMUmcl.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CMUmcl"
        Icon="/Assets/CMUmcl.ico"
        Width="420" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Branding -->
        <TextBlock Grid.Row="0" Text="CMUmcl" FontSize="34" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Text="中南大学 Minecraft 社区启动器"
                   FontSize="14" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,24" />

        <!-- Account -->
        <TextBlock Grid.Row="2" Text="CSU-MC 皮肤站账号" Style="{StaticResource Label}" />
        <TextBox x:Name="UsernameBox" Grid.Row="3" Height="38" Margin="0,0,0,12"
                 KeyDown="UsernameBox_KeyDown" />

        <!-- Password -->
        <TextBlock Grid.Row="4" Text="密码" Style="{StaticResource Label}" />
        <PasswordBox x:Name="PasswordBox" Grid.Row="5" Height="38" Margin="0,0,0,12"
                     KeyDown="PasswordBox_KeyDown" />

        <!-- Error message -->
        <TextBlock x:Name="ErrorText" Grid.Row="6" Text=""
                   Foreground="{StaticResource ErrorBrush}" FontSize="13"
                   TextWrapping="Wrap" Margin="0,0,0,10" MinHeight="18" />

        <!-- Remember login -->
        <CheckBox x:Name="RememberBox" Grid.Row="7" Content="记住登录"
                  HorizontalAlignment="Left" Margin="0,0,0,16" IsChecked="True" />

        <!-- Buttons -->
        <Grid Grid.Row="8" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button x:Name="LoginButton" Grid.Row="0" Content="登录"
                    Style="{StaticResource PrimaryButton}" Height="42"
                    Click="LoginButton_Click" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Content="注册账号" Style="{StaticResource LinkButton}" Click="RegisterButton_Click" />
                <TextBlock Text="·" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="4,0" />
                <Button Content="忘记密码" Style="{StaticResource LinkButton}" Click="ForgotButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Version -->
        <TextBlock Grid.Row="9" Text="版本 0.1.0" FontSize="11"
                   Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" />
    </Grid>
</Window>
