<UserControl x:Class="CMUmcl.Community.CommunityResourceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CMUmcl.Community"
 Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  <local:ResourceKindEqualsConverter x:Key="KindEquals" />
  <Style x:Key="ResourceTab" TargetType="Button">
   <Setter Property="Padding" Value="16,9" /><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource KindEquals}"><Binding Path="DataContext.Kind" RelativeSource="{RelativeSource Self}"/><Binding Path="Tag" RelativeSource="{RelativeSource Self}"/></MultiBinding></DataTrigger.Binding>
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
   </DataTrigger></Style.Triggers>
  </Style>
  <CollectionViewSource x:Key="DependencyGroups" Source="{Binding Detail.Dependencies}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="GroupLabel"/></CollectionViewSource.GroupDescriptions></CollectionViewSource>
  <CollectionViewSource x:Key="VersionGroups" Source="{Binding Detail.Versions}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="GameLabel" /></CollectionViewSource.GroupDescriptions></CollectionViewSource>
 </UserControl.Resources>
 <Grid Margin="20,14,20,18">
  <!-- HMCL 3.16.4: search card followed by a full-width result list. -->
  <Grid x:Name="BrowsePage" Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibility}}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="模组" Tag="{x:Static local:ResourceKind.Mod}" Command="{Binding SelectKindCommand}" CommandParameter="{x:Static local:ResourceKind.Mod}" Style="{StaticResource ResourceTab}" Margin="0,0,8,0" />
                    <Button Content="整合包" Tag="{x:Static local:ResourceKind.Modpack}" Command="{Binding SelectKindCommand}" CommandParameter="{x:Static local:ResourceKind.Modpack}" Style="{StaticResource ResourceTab}" Margin="0,0,8,0" />
                    <Button Content="资源包" Tag="{x:Static local:ResourceKind.ResourcePack}" Command="{Binding SelectKindCommand}" CommandParameter="{x:Static local:ResourceKind.ResourcePack}" Style="{StaticResource ResourceTab}" Margin="0,0,8,0" />
                    <Button Content="光影" Tag="{x:Static local:ResourceKind.Shader}" Command="{Binding SelectKindCommand}" CommandParameter="{x:Static local:ResourceKind.Shader}" Style="{StaticResource ResourceTab}" Margin="0,0,8,0" />
                    <Button Content="数据包" Tag="{x:Static local:ResourceKind.Datapack}" Command="{Binding SelectKindCommand}" CommandParameter="{x:Static local:ResourceKind.Datapack}" Style="{StaticResource ResourceTab}" Margin="0,0,8,0" />
   </StackPanel>
   <Border x:Name="SearchFilters" Grid.Row="1" Style="{DynamicResource PackCard}" Margin="0,0,0,10">
    <Border.Resources>
     <Style TargetType="TextBox">
      <Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,0"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="SelectionOpacity" Value="0.35"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputFrame" CornerRadius="6" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
     </Style>
     <!-- Same rounded, accent-focused dropdown as the rest of the launcher; only the height is compact here. -->
     <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,0,4,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    </Border.Resources>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/></Grid.RowDefinitions>
     <TextBlock Visibility="{Binding ShowInstanceFilters, Converter={StaticResource BoolToVisibility}}" Text="目标实例" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
     <ComboBox Visibility="{Binding ShowInstanceFilters, Converter={StaticResource BoolToVisibility}}" x:Name="TargetFilter" Grid.Column="1" ItemsSource="{Binding TargetInstances}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTarget}" Margin="0,3,16,3" ToolTip="按实例筛选兼容资源"/>
     <TextBlock Grid.Column="2" Text="下载源" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
     <ComboBox x:Name="SourceFilter" Grid.Column="3" ItemsSource="{Binding SourceOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSourceOption}" Margin="0,3,0,3"/>
     <TextBlock Grid.Row="1" Text="名称" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
     <TextBox x:Name="ResourceSearchText" Grid.Row="1" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,16,3" ToolTip="输入名称，按 Enter 搜索"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox>
     <TextBlock Grid.Row="1" Grid.Column="2" Text="游戏版本" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
     <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding GameVersion, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,3" ToolTip="留空表示全部版本"/>
     <TextBlock Grid.Row="2" Text="加载器" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Visibility="{Binding ShowLoaderFilter, Converter={StaticResource BoolToVisibility}}"/>
     <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding LoaderOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedLoaderOption}" Margin="0,3,16,3" Visibility="{Binding ShowLoaderFilter, Converter={StaticResource BoolToVisibility}}"/>
     <TextBlock Grid.Row="2" Grid.Column="2" Text="排序" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
     <ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSortOption}" Margin="0,3,0,3"/>
    </Grid>
   </Border>
   <DockPanel Grid.Row="2" Margin="2,0,2,10">
    <CheckBox DockPanel.Dock="Right" Visibility="{Binding ShowInstanceFilters, Converter={StaticResource BoolToVisibility}}" Content="仅显示兼容资源" IsChecked="{Binding OnlyCompatible}" IsEnabled="{Binding CanFilterCompatibility}"/>
    <TextBlock Text="{Binding ResultSummary}" Foreground="{DynamicResource MutedTextBrush}"/>
   </DockPanel>
   <Grid Grid.Row="3">
    <ListBox x:Name="ResourceResults" Foreground="{DynamicResource TextBrush}" ItemsSource="{Binding Results}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <Button Foreground="{DynamicResource TextBrush}" Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="0" BorderThickness="0" Background="Transparent">
       <Button.FocusVisualStyle><x:Null/></Button.FocusVisualStyle>
       <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Card" Style="{DynamicResource PackCard}" Margin="0" Cursor="Hand"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
        <Border Width="48" Height="48" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top"><Grid><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/><Image Source="{Binding Icon}" Stretch="UniformToFill"/></Grid></Border>
        <StackPanel Grid.Column="1" Margin="12,0,12,0">
         <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding SourceLabel}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="10,0,0,0"/><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
         <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0,5,0,7"/>
         <WrapPanel><TextBlock Text="{Binding Author}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,16,0"/><TextBlock Text="{Binding DownloadsText, StringFormat={}{0} 次下载}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,16,0"/><TextBlock Text="{Binding UpdatedText}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,16,0"/><TextBlock Visibility="{Binding ShowCompatibility, Converter={StaticResource BoolToVisibility}}" Text="{Binding HintText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/></WrapPanel>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="›" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
       </Grid>
      </Button>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowLoadingOverlay, Converter={StaticResource BoolToVisibility}}"><ProgressBar Width="160" Height="4" IsIndeterminate="True"/><TextBlock Text="正在搜索…" Margin="0,14,0,0" HorizontalAlignment="Center"/></StackPanel>
    <TextBlock Text="{Binding EmptyMessage}" Visibility="{Binding HasEmptyMessage, Converter={StaticResource BoolToVisibility}}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
    <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding ErrorMessage}" MaxWidth="520" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"/><Button Content="重试" Command="{Binding SearchCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,12,0,0"/></StackPanel>
   </Grid>
   <StackPanel Grid.Row="4">
    <TextBlock Text="{Binding PartialMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Visibility="{Binding HasPartialMessage, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0"/>
    <DockPanel x:Name="ResourcePagingBar" Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="搜索" Command="{Binding SearchCommand}" Style="{DynamicResource PrimaryButton}" MinWidth="100"/>
     <StackPanel Orientation="Horizontal"><Button Content="首页" Command="{Binding FirstPageCommand}" Style="{DynamicResource SecondaryButton}"/><Button Content="上一页" Command="{Binding PreviousPageCommand}" Style="{DynamicResource SecondaryButton}" Margin="6,0,0,0"/><TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="14,0" Foreground="{DynamicResource MutedTextBrush}"/><Button Content="下一页" Command="{Binding NextPageCommand}" Style="{DynamicResource SecondaryButton}"/></StackPanel>
    </DockPanel>
   </StackPanel>
  </Grid>
  <!-- HMCL 3.16.4: dedicated project page, grouped versions, explicit install target. -->
  <Grid x:Name="DetailPage" Visibility="{Binding IsDetailPage, Converter={StaticResource BoolToVisibility}}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Button Content="{Binding BackLabel}" Command="{Binding BackToResultsCommand}" Style="{DynamicResource LinkButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
   <Border Grid.Row="1" Style="{DynamicResource PackCard}" Margin="0,0,0,10">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="48" Height="48" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6"><Grid><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/><Image Source="{Binding SelectedCard.Icon}"/></Grid></Border>
     <StackPanel Grid.Column="1" Margin="12,0,18,0"><TextBlock Text="{Binding SelectedCard.Title}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedCard.Description}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
     <Button x:Name="ProjectWebsiteButton" Grid.Column="2" Content="官方网站 ▾" ToolTip="在 Modrinth 或 CurseForge 查看" MinWidth="112" SnapsToDevicePixels="True" UseLayoutRounding="True" Click="OpenProjectUrl_Click" Style="{DynamicResource LinkButton}" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   <Grid Grid.Row="2">
    <Grid Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,8"><CheckBox DockPanel.Dock="Right" Content="显示全部版本" IsChecked="{Binding Detail.ShowAllVersions}"/><StackPanel><TextBlock Text="选择要安装的版本" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="未找到兼容版本，已显示全部版本。" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Visibility="{Binding Detail.NoCompatibleVersion, Converter={StaticResource BoolToVisibility}}"/></StackPanel></DockPanel>
     <ListBox x:Name="VersionList" Foreground="{DynamicResource TextBrush}" Grid.Row="1" ItemsSource="{Binding Source={StaticResource VersionGroups}}" SelectedItem="{Binding Detail.SelectedVersion}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Foreground="{DynamicResource TextBrush}" Text="{Binding Name, StringFormat=Minecraft {0}}" FontWeight="SemiBold" Margin="4,12,0,6"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Button Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.OpenVersionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding DateLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="12,0,0,0"/><StackPanel><TextBlock Text="{Binding VersionNumber}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LoaderLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel></DockPanel></Button></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibility}}"><ProgressBar Width="160" Height="4" IsIndeterminate="True"/><TextBlock Text="正在加载项目版本…" Margin="0,14,0,0"/></StackPanel>
    <TextBlock Text="{Binding DetailError}" Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibility}}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid>

  </Grid>
  <Grid x:Name="VersionDialog" Background="#66000000" Visibility="{Binding IsVersionDialogOpen, Converter={StaticResource BoolToVisibility}}">
   <Border Width="600" Height="440" MaxHeight="{Binding ActualHeight, ElementName=VersionDialog}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource PackCard}" Background="{DynamicResource PopupBrush}" Padding="20">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0"><Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseVersionDialogCommand}" Style="{DynamicResource LinkButton}" VerticalAlignment="Top"/><StackPanel><TextBlock Text="版本详情" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail.SelectedVersion.VersionNumber}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"/></StackPanel></DockPanel>
   <Border Grid.Row="1" BorderThickness="0" Padding="0" Margin="0,12,0,0" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
    <Grid DataContext="{Binding Detail}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"><StackPanel>
      <StackPanel x:Name="DependencySection" Visibility="{Binding HasDependencies, Converter={StaticResource BoolToVisibility}}">
       <TextBlock Text="{Binding DependencyNotice}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
       <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsLoadingDependencies, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8"/>
       <ItemsControl x:Name="DependencyList" ItemsSource="{Binding Source={StaticResource DependencyGroups}}">
        <ItemsControl.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,6" Foreground="{DynamicResource TextBrush}"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ItemsControl.GroupStyle>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Button Foreground="{DynamicResource TextBrush}" Padding="0" Margin="0,0,0,6" HorizontalContentAlignment="Stretch" IsEnabled="{Binding CanOpen}" Command="{Binding DataContext.OpenDependencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
          <Button.Template><ControlTemplate TargetType="Button"><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="10" CornerRadius="0"><ContentPresenter/></Border></ControlTemplate></Button.Template>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
           <Border Width="32" Height="32" Background="{DynamicResource AccentSoftBrush}"><Grid><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Icon}"/></Grid></Border>
           <StackPanel Grid.Column="1" Margin="8,0,8,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,3,0,0"/><TextBlock Text="{Binding VersionNote}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
           <TextBlock Grid.Column="2" Text="›" VerticalAlignment="Center"/>
          </Grid>
         </Button>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <StackPanel Visibility="{Binding HasDependencyError, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding DependencyError}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"/><Button Content="重试加载前置" Command="{Binding RetryDependenciesCommand}" Style="{DynamicResource LinkButton}" HorizontalAlignment="Left"/></StackPanel>
      </StackPanel>
                        <TextBlock Text="数据包世界" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,14,0,0"
                                   Visibility="{Binding ShowWorldSelector, Converter={StaticResource BoolToVisibility}}" />
                        <ComboBox Margin="0,6,0,0" ItemsSource="{Binding Worlds}" SelectedItem="{Binding SelectedWorld}"
                                  Visibility="{Binding ShowWorldSelector, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="整合包名称" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,14,0,0"
                                   Visibility="{Binding ShowModpackName, Converter={StaticResource BoolToVisibility}}" />
                        <TextBox Margin="0,6,0,0" Text="{Binding NewInstanceName, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ShowModpackName, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="保存位置" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,14,0,0"
                                   Visibility="{Binding ShowModpackSavePath, Converter={StaticResource BoolToVisibility}}" />
                        <Grid Margin="0,6,0,0" Visibility="{Binding ShowModpackSavePath, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ModpackSavePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="ZIP 整合包保存路径" />
                            <Button Grid.Column="1" Content="选择…" Margin="8,0,0,0" Style="{DynamicResource SecondaryButton}" Click="BrowseModpackSavePath_Click" />
                        </Grid>

                        <TextBlock Text="{Binding SoftWarningText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Visibility="{Binding HasSoftWarnings, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding HardBlock}" FontSize="12" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasHardBlock, Converter={StaticResource BoolToVisibility}}" />


     </StackPanel></ScrollViewer>
     <StackPanel Grid.Row="1" IsEnabled="{Binding CanChangeSelection}">                        <TextBlock Text="目标实例" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,14,0,0"
                                   Visibility="{Binding ShowTargetSelectors, Converter={StaticResource BoolToVisibility}}" />
                        <ComboBox Margin="0,6,0,0" ItemsSource="{Binding Instances}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedInstance}"
                                  Visibility="{Binding ShowTargetSelectors, Converter={StaticResource BoolToVisibility}}" />

</StackPanel>
     <DockPanel Grid.Row="2" Margin="0,10,0,0"><Button DockPanel.Dock="Right" x:Name="CommunityInstallButton" Content="安装 / 下载" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" Style="{DynamicResource PrimaryButton}" MinWidth="140"/><StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
     <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" Height="4" Margin="0,8,0,0" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
   </Border>
    </Grid>
   </Border>
  </Grid>

 </Grid>
</UserControl>
