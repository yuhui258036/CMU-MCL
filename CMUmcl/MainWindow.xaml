<Window x:Class="CMUmcl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CMUmcl"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="NavItemActive" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="NavItemDisabled" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>

        <!-- Server pack card -->
        <Style x:Key="PackCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- Settings page styles -->
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource PackCard}">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <TextBlock Grid.Row="0" Text="CMUmcl" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" Margin="20,20,20,18" />

                <!-- Nav -->
                <StackPanel Grid.Row="1" Margin="12,0">
                    <Button x:Name="PacksNavButton" Content="服务器整合包" Style="{StaticResource NavItemActive}" Click="PacksNavButton_Click" />
                    <Button x:Name="SettingsNavButton" Content="设置" Style="{StaticResource NavItem}" Click="SettingsNavButton_Click" />
                </StackPanel>

                <!-- Account card -->
                <Border Grid.Row="3" Background="{StaticResource BgBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="已登录" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="AccountNameText" Text="" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,2,0,10"
                                   TextTrimming="CharacterEllipsis" />
                        <Button x:Name="LogoutButton" Content="退出登录"
                                Style="{StaticResource PrimaryButton}" Click="LogoutButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== Main ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderTitleText" Grid.Column="0" Text="服务器整合包" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderStatusText" Grid.Column="1" Text=""
                               Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                               VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="NewInstanceButton" Content="新建实例" Height="34" Margin="0,0,10,0"
                                Style="{StaticResource PrimaryButton}" Click="NewInstanceButton_Click" />
                        <Button x:Name="RefreshButton" Content="刷新" Width="86" Height="34"
                                Style="{StaticResource PrimaryButton}" Click="RefreshButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,20">
                        <ItemsControl x:Name="CardsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PackCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding RevisionText}" FontSize="12"
                                                               Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           VerticalAlignment="Top" />
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="13"
                                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                       Margin="0,10,0,10" />

                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding GameText}" FontSize="12"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="3" Text="{Binding ServerText}" FontSize="12"
                                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                                            <TextBlock Grid.Row="4" Text="{Binding LoaderNote}" FontSize="12"
                                                       Foreground="{StaticResource AccentBrush}" Margin="0,-6,0,8"
                                                       Visibility="{Binding HasLoaderNote, Converter={StaticResource BoolToVisibility}}" />

                                            <Grid Grid.Row="5">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                                                               FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                                    <TextBlock Grid.Column="1" />
                                                    <Button Grid.Column="2" Content="{Binding ButtonText, Mode=OneWay}"
                                                            IsEnabled="{Binding ButtonEnabled, Mode=OneWay}"
                                                            Style="{StaticResource PrimaryButton}"
                                                            MinWidth="120" Height="34"
                                                            Click="InstallButton_Click" />
                                                </Grid>
                                                <ProgressBar Grid.Row="1" Height="6" Margin="0,10,0,0"
                                                             Visibility="{Binding IsProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                             Minimum="0" Maximum="100"
                                                             Value="{Binding ProgressValue, Mode=OneWay}"
                                                             Foreground="{StaticResource AccentBrush}"
                                                             Background="{StaticResource PanelBorderBrush}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Overlay states -->
                <TextBlock x:Name="EmptyStateText" Text="暂无服务器整合包。"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="正在获取服务器整合包…" Foreground="{StaticResource MutedTextBrush}" FontSize="15" />
                </StackPanel>
                <StackPanel x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed" MaxWidth="520">
                    <TextBlock x:Name="ErrorText" Text="" Foreground="{StaticResource ErrorBrush}" FontSize="14"
                               TextWrapping="Wrap" HorizontalAlignment="Center" />
                    <Button x:Name="RetryButton" Content="重试" Width="100" Height="34"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                            Click="RefreshButton_Click" />
                </StackPanel>

                <!-- Settings view -->
                <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="24,20" MaxWidth="760">
                        <!-- Java -->
                        <TextBlock Text="Java" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <RadioButton x:Name="JavaAutoRadio" Content="自动选择" GroupName="JavaMode" Checked="JavaMode_Checked" />
                                <RadioButton x:Name="JavaManualRadio" Content="手动指定" GroupName="JavaMode" Checked="JavaMode_Checked" Margin="0,8,0,0" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="JavaPathTextBox" Grid.Column="0" Margin="0,0,8,0"
                                             TextChanged="JavaPathTextBox_TextChanged" />
                                    <Button x:Name="BrowseJavaButton" Grid.Column="1" Content="浏览…" MinWidth="72" Height="34"
                                            Click="BrowseJavaButton_Click" />
                                </Grid>
                                <TextBlock x:Name="JavaDetectedText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="JavaErrorText" FontSize="12" Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Memory -->
                        <TextBlock Text="内存" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock x:Name="SystemMemoryText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="MemoryTextBox" Grid.Column="0" Width="120" PreviewTextInput="MemoryTextBox_PreviewTextInput" />
                                    <TextBlock Grid.Column="1" Text="MB" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock x:Name="MemoryErrorText" FontSize="12" Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Version isolation -->
                        <TextBlock Text="版本隔离" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <ComboBox x:Name="IsolationComboBox" Width="180" HorizontalAlignment="Left"
                                          SelectionChanged="IsolationComboBox_SelectionChanged" />
                                <TextBlock x:Name="IsolationHintText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="提示：更改版本隔离后，已有世界/配置不会自动迁移；模组实例 = 加载器非空且非原版。" FontSize="12"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Directory -->
                        <TextBlock Text="目录" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="启动器根目录" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="RootPathText" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <Button x:Name="OpenRootButton" Content="打开根目录" MinWidth="120" Height="34" HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Click="OpenRootButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Instance storage location -->
                        <TextBlock Text="实例存放位置" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="实例目录" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InstancesDirectoryTextBox" Grid.Column="0" Margin="0,0,8,0"
                                             TextChanged="InstancesDirectoryTextBox_TextChanged" />
                                    <Button x:Name="BrowseInstancesButton" Grid.Column="1" Content="浏览…" MinWidth="72" Height="34"
                                            Click="BrowseInstancesButton_Click" />
                                </Grid>
                                <TextBlock x:Name="InstancesDirectoryHintText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="InstancesDirectoryErrorText" FontSize="12" Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                                <Button x:Name="OpenInstancesButton" Content="打开实例目录" MinWidth="120" Height="34" HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Click="OpenInstancesButton_Click" />
                                <TextBlock Text="提示：更改存放位置后，已有实例将被迁移；名称冲突时会自动追加 -2、(2) 等后缀。" FontSize="12"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Save -->
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SaveSettingsButton" Content="保存设置" Width="120" Height="36"
                                    Style="{StaticResource PrimaryButton}" Click="SaveSettingsButton_Click" />
                            <TextBlock x:Name="SettingsStatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- No-launch note -->
                <TextBlock x:Name="NoLaunchNote" Text="启动功能将在下一步接入" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" />
            </Grid>
        </Grid>
    </Grid>
</Window>
