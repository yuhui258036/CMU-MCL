<Window x:Class="CMUmcl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CMUmcl"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Foreground="{DynamicResource TextBrush}"
        Title="CMUmcl" WindowStyle="None" ResizeMode="CanResize"
        Icon="/Assets/CMUmcl.ico"
        Width="1200" Height="800"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackdropBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>

        <!-- ============ Local brushes (do not depend on App changes) ============ -->

        <!-- ============ Navigation ============ -->
        <!-- Code-behind swaps these via FindResource("NavItem") / FindResource("NavItemActive"). -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <Grid>
                                <Border x:Name="indicator" Width="3" CornerRadius="1.5"
                                        HorizontalAlignment="Left" Margin="0,9"
                                        Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                <Border x:Name="overlay" Background="Transparent" CornerRadius="6" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="overlay" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.8" /></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="overlay" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Active">
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItemActive" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Tag" Value="Active" />
        </Style>

        <!-- ============ Buttons ============ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ActionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ActionBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource ModernButtonTemplate}" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource ModernButtonTemplate}" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource ModernButtonTemplate}" />
        </Style>

        <!-- ============ Cards ============ -->
        <Style x:Key="PackCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource PackCard}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="20,18" />
        </Style>

        <!-- ============ Chips / tags ============ -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <Style x:Key="ChipAccent" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <!-- ============ Typography ============ -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="SectionIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ============ TextBox ============ -->

        <!-- ============ ComboBox ============ -->




        <!-- ============ RadioButton ============ -->


        <!-- ============ CheckBox ============ -->


        <!-- ============ ProgressBar ============ -->


    </Window.Resources>

    <Grid x:Name="WindowSurface" Background="{DynamicResource WindowBackdropBrush}">
        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SidebarBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Margin="18,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="ThemeToggleButton" ToolTip="主题模式" AutomationProperties.Name="切换主题模式" Style="{StaticResource IconButton}" Click="ToggleTheme_Click">
                    <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path x:Name="ThemeIcon" Data="{StaticResource MoonIconGeometry}" Style="{StaticResource TitleIconPath}" /></Canvas></Viewbox>
                </Button>
                <Border Width="1" Height="14" Background="{DynamicResource SeparatorBrush}" Margin="6,0" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                <Button ToolTip="最小化" AutomationProperties.Name="最小化" Style="{StaticResource IconButton}" Click="MinimizeWindow_Click">
                    <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M5,12 L19,12" Style="{StaticResource TitleIconPath}" /></Canvas></Viewbox>
                </Button>
                <Button ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原" Style="{StaticResource IconButton}" Click="MaximizeWindow_Click">
                    <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path><Path.Style><Style TargetType="Path" BasedOn="{StaticResource TitleIconPath}"><Setter Property="Data" Value="M5,5 H19 V19 H5 Z" /><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Data" Value="M8,4 H20 V16 M4,8 H16 V20 H4 Z" /></DataTrigger></Style.Triggers></Style></Path.Style></Path></Canvas></Viewbox>
                </Button>
                <Button ToolTip="关闭" AutomationProperties.Name="关闭" Style="{StaticResource IconButton}" Click="CloseWindow_Click">
                    <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Style="{StaticResource TitleIconPath}" /></Canvas></Viewbox>
                </Button>
            </StackPanel>
        </Grid>
        <!-- ===================== Sidebar ===================== -->
        <Border x:Name="SidebarSurface" Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,22,20,18">
                    <Border Width="42" Height="42" CornerRadius="6"
                            Background="Transparent" BorderThickness="0"
                            ClipToBounds="True">
                        <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Source><BitmapImage UriSource="/Assets/CMUmcl-icon.png" DecodePixelWidth="168" /></Image.Source>
                        </Image>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CMUmcl" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="中南大学 Minecraft 社区" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Nav -->
                <StackPanel Grid.Row="1" Margin="12,4,12,0">
                    <Button x:Name="PacksNavButton" Style="{StaticResource NavItemActive}" Click="PacksNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Width="22" />
                            <TextBlock Text="整合包" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="InstancesNavButton" Style="{StaticResource NavItem}" Click="InstancesNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Width="22" />
                            <TextBlock Text="实例" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavItem}" Click="SettingsNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Width="22" />
                            <TextBlock Text="设置" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Account card -->
                <Border Grid.Row="3" Background="Transparent"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0"
                        Padding="16,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="已登录" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="AccountNameText" Text="" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button x:Name="LogoutButton" Grid.Column="2" Content="退出" VerticalAlignment="Center"
                                Style="{StaticResource GhostButton}" Click="LogoutButton_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== Main ===================== -->
        <Grid x:Name="MainContent" Grid.Row="1" Grid.Column="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=CreateInstanceView}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="28,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitleText" Text="服务器整合包" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="HeaderStatusText" Text=""
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NewInstanceButton" Margin="0,0,10,0"
                                Style="{StaticResource PrimaryButton}" Click="NewInstanceButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="新建实例" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButton}"
                                Click="RefreshButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="刷新" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1">

                <!-- ============ 服务器整合包 page ============ -->
                <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,22">
                        <ItemsControl x:Name="CardsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PackCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Icon -->
                                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="6"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" Margin="16,0,20,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="16"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                                <TextBlock Text="{Binding Description}" FontSize="13"
                                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                                           Margin="0,8,0,0" />

                                                <WrapPanel Margin="0,10,0,0">
                                                    <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                                        <TextBlock Text="{Binding GameText}" FontSize="11"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                                        <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                                        <TextBlock Text="{Binding RevisionText}" FontSize="11"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                                        <TextBlock Text="{Binding ServerText}" FontSize="11"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                    </Border>
                                                </WrapPanel>

                                                <TextBlock Text="{Binding LoaderNote}" FontSize="12"
                                                           Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasLoaderNote, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>

                                            <!-- Status + actions -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           HorizontalAlignment="Right" Margin="0,0,0,10"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="230" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="查看实例"
                                                            Visibility="{Binding IsViewInstancesVisible, Converter={StaticResource BoolToVisibility}}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            MinWidth="96" Margin="0,0,10,0"
                                                            Click="ViewInstancesButton_Click" />
                                                    <Button Content="{Binding ButtonText, Mode=OneWay}"
                                                            IsEnabled="{Binding ButtonEnabled, Mode=OneWay}"
                                                            Visibility="{Binding IsInstallVisible, Converter={StaticResource BoolToVisibility}}"
                                                            Style="{StaticResource PrimaryButton}"
                                                            MinWidth="120"
                                                            Click="InstallButton_Click" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Progress -->
                                            <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0"
                                                         Visibility="{Binding IsProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding ProgressValue, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Packs overlay states -->
                <StackPanel x:Name="EmptyStateText" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                               Foreground="{DynamicResource PanelBorderBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="暂无服务器整合包。" Foreground="{DynamicResource MutedTextBrush}" FontSize="15"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="点击右上角「刷新」重新加载" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.7" />
                </StackPanel>

                <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressBar Width="160" Height="4" IsIndeterminate="True" />
                    <TextBlock Text="正在获取服务器整合包…" Foreground="{DynamicResource MutedTextBrush}" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>

                <StackPanel x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed" MaxWidth="520">
                    <Border Width="48" Height="48" CornerRadius="6" Background="{DynamicResource ErrorBrush}"
                            HorizontalAlignment="Center" Opacity="0.15">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="ErrorText" Text="" Foreground="{DynamicResource ErrorBrush}" FontSize="14"
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <Button x:Name="RetryButton" Content="重试" MinWidth="100"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0"
                            Click="RefreshButton_Click" />
                </StackPanel>

                <!-- ============ 实例 page ============ -->
                <ScrollViewer x:Name="InstancesScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="28,22">
                        <ItemsControl x:Name="InstancesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PackCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Icon -->
                                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="6"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" Margin="16,0,20,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="16"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Style="{StaticResource ChipAccent}" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding SourceText}" FontSize="11"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                </Grid>

                                                <Border Style="{StaticResource Chip}" Margin="0,10,0,0" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding GameText}" FontSize="11"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </Border>

                                                <TextBlock Text="{Binding PathText}" FontSize="12"
                                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Content="{Binding ButtonText, Mode=OneWay}"
                                                        IsEnabled="{Binding ButtonEnabled, Mode=OneWay}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        MinWidth="110" Click="LaunchButton_Click" />
                                                <Button Content="打开目录" MinWidth="90" Margin="10,0,0,0"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="OpenInstanceDirButton_Click" />
                                                <Button Content="实例设置" MinWidth="90" Margin="10,0,0,0"
                                                        Style="{StaticResource SecondaryButton}" IsEnabled="False" />
                                            </StackPanel>

                                            <!-- Progress -->
                                            <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0"
                                                         Visibility="{Binding IsProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding ProgressValue, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Instances empty state -->
                <StackPanel x:Name="InstancesEmptyStateText" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                               Foreground="{DynamicResource PanelBorderBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="暂无已安装实例。" Foreground="{DynamicResource MutedTextBrush}" FontSize="15"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="点击右上角新建实例" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.7" />
                </StackPanel>

                <!-- ============ 设置 page ============ -->
                <Grid x:Name="SettingsScroll" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Background="{DynamicResource SidebarBrush}" CornerRadius="6" Padding="4,2" Margin="28,18,28,0" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RuntimeTab" Content="游戏设置" Tag="Runtime" Style="{StaticResource NavItemActive}" Click="SettingsTab_Click" />
                        <Button x:Name="AppearanceTab" Content="外观" Tag="Appearance" Margin="8,2" Style="{StaticResource NavItem}" Click="SettingsTab_Click" />
                        <Button x:Name="ProxyTab" Content="代理" Tag="Proxy" Margin="0,2,8,2" Style="{StaticResource NavItem}" Click="SettingsTab_Click" />
                        <Button x:Name="StorageTab" Content="游戏目录" Tag="Storage" Style="{StaticResource NavItem}" Click="SettingsTab_Click" />
                        <Button x:Name="UpdateTab" Content="更新" Tag="Update" Margin="8,2" Style="{StaticResource NavItem}" Click="SettingsTab_Click" />
                    </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="SettingsContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,18" MaxWidth="900" HorizontalAlignment="Stretch">

                        <!-- Java -->
                        <Border x:Name="JavaCard" Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xE756;" Style="{StaticResource SectionIcon}" />
                                    <StackPanel>
                                        <TextBlock Text="游戏 Java" Style="{StaticResource SectionHeader}" />
                                        <TextBlock Text="选择运行游戏所用的 Java。" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <WrapPanel>
                                <RadioButton x:Name="JavaAutoRadio" Content="自动选择合适的 Java" GroupName="JavaMode" Checked="JavaMode_Checked" Margin="0,0,24,0" />
                                <RadioButton x:Name="JavaManualRadio" Content="自定义" GroupName="JavaMode" Checked="JavaMode_Checked" />
                                </WrapPanel>
                                <Grid Margin="0,14,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="JavaCandidatesCombo" DisplayMemberPath="DisplayName" SelectionChanged="JavaCandidate_SelectionChanged" Margin="0,0,8,0" ToolTip="选择 Java 版本；启动时检查兼容性。" />
                                    <TextBlock Text="选择 Java" Margin="12,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource MutedTextBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=JavaCandidatesCombo}" Value="-1"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <Button x:Name="ScanJavaButton" Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButton}" Click="ScanJava_Click" />
                                </Grid>
                                <TextBlock x:Name="JavaScanStatus" Style="{StaticResource Caption}" Text="检测本机 Java 后，可查看版本、架构与路径。" />
                                <Grid x:Name="JavaPathRow" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="JavaPathTextBox" Grid.Column="0" Margin="0,0,8,0"
                                             TextChanged="JavaPathTextBox_TextChanged" />
                                    <Button x:Name="BrowseJavaButton" Grid.Column="1" Content="浏览…" MinWidth="80"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BrowseJavaButton_Click" />
                                </Grid>
                                <TextBlock x:Name="JavaDetectedText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,10,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="JavaErrorText" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                           Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ProxyCard" Style="{StaticResource SettingsCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="代理" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="用于启动器登录、下载、更新及网络背景。" Style="{StaticResource FieldHint}" Margin="0,4,0,18" />
                                <ComboBox x:Name="ProxyModeCombo" Width="230" HorizontalAlignment="Left" SelectionChanged="ProxyMode_Changed">
                                    <ComboBoxItem Content="使用系统代理" /><ComboBoxItem Content="不使用代理" /><ComboBoxItem Content="HTTP" /><ComboBoxItem Content="SOCKS5" />
                                </ComboBox>
                                <StackPanel x:Name="ProxyDetailsPanel" Margin="0,20,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="主机" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                        <TextBlock Text="端口" Grid.Column="2" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                        <TextBox x:Name="ProxyHostTextBox" Grid.Row="1" TextChanged="ProxyField_Changed" />
                                        <TextBox x:Name="ProxyPortTextBox" Grid.Row="1" Grid.Column="2" TextChanged="ProxyField_Changed" PreviewTextInput="MemoryTextBox_PreviewTextInput" />
                                    </Grid>
                                    <CheckBox x:Name="ProxyAuthenticationCheck" Content="身份验证" Margin="0,22,0,14" Checked="ProxyAuthentication_Changed" Unchecked="ProxyAuthentication_Changed" />
                                    <Grid x:Name="ProxyCredentialsPanel">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="账户" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                        <TextBlock Text="密码" Grid.Column="2" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                        <TextBox x:Name="ProxyUsernameTextBox" Grid.Row="1" TextChanged="ProxyField_Changed" />
                                        <PasswordBox x:Name="ProxyPasswordBox" Grid.Row="1" Grid.Column="2" PasswordChanged="ProxyPassword_Changed" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock x:Name="ProxyErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                <Border Height="1" Background="{DynamicResource PanelBorderBrush}" Margin="0,12,0,16" />
                                <TextBlock Text="修改后自动保存，新请求使用新的代理设置；正在进行的下载不受影响。" Style="{StaticResource FieldHint}" />
                                <TextBlock Text="此设置不改变 Minecraft 游戏内连接，也不能绕过系统 VPN 或 TUN。" Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                        <!-- Memory -->
                        <Border x:Name="MemoryCard" Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xE950;" Style="{StaticResource SectionIcon}" />
                                    <StackPanel>
                                        <TextBlock Text="游戏内存" Style="{StaticResource SectionHeader}" />
                                        <TextBlock Text="设置分配给游戏的最大内存。" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <RadioButton x:Name="MemoryAutoRadio" Content="自动分配内存" GroupName="MemoryMode" Checked="MemoryMode_Changed" />
                                    <RadioButton x:Name="MemoryManualRadio" Content="手动选择内存" GroupName="MemoryMode" Checked="MemoryMode_Changed" Margin="24,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="SystemMemoryText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="MemoryTextBox" Grid.Column="0" Width="140"
                                             TextChanged="MemoryTextBox_Changed" PreviewTextInput="MemoryTextBox_PreviewTextInput" />
                                    <TextBlock Grid.Column="1" Text="MiB" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                                <Slider x:Name="MemorySlider" Minimum="512" Maximum="32768" TickFrequency="256" IsSnapToTickEnabled="True" Margin="0,16,0,10" ValueChanged="MemorySlider_Changed" />
                                <ProgressBar x:Name="MemoryUsageBar" Height="8" Maximum="100" />
                                <TextBlock x:Name="MemoryAdviceText" Style="{StaticResource FieldHint}" />
                                <TextBlock x:Name="MemoryErrorText" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                           Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>


                        <Border x:Name="AppearanceCard" Style="{StaticResource SettingsCard}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="主题模式" Style="{StaticResource SectionHeader}" /><TextBlock Text="选择启动器的浅色或深色外观。" Style="{StaticResource FieldHint}" /></StackPanel>
                                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectionChanged="Appearance_Changed">
                                        <ComboBoxItem Content="跟随系统设置" /><ComboBoxItem Content="浅色模式" /><ComboBoxItem Content="深色模式" />
                                    </ComboBox>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource PanelBorderBrush}" Margin="0,22" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="背景图片" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="BackgroundModeCombo" Grid.Column="1" SelectionChanged="BackgroundMode_Changed">
                                        <ComboBoxItem Content="默认" /><ComboBoxItem Content="自定义" /><ComboBoxItem Content="网络" />
                                    </ComboBox>
                                </Grid>
                                <StackPanel x:Name="LocalBackgroundPanel" Margin="0,18,0,0" Visibility="Collapsed">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BackgroundImageCount" Text="未选择图片" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <Button x:Name="AddBackgroundButton" Grid.Column="1" Content="选择背景图片" Style="{StaticResource SecondaryButton}" Click="ChooseBackground_Click" />
                                    </Grid>
                                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                                        <ItemsControl x:Name="BackgroundImagesList"><ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="删除" Tag="{Binding}" Style="{StaticResource GhostButton}" Click="RemoveBackground_Click" />
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="BackgroundImportError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel x:Name="NetworkBackgroundPanel" Margin="0,18,0,0" Visibility="Collapsed">
                                    <TextBlock Text="图片地址" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                    <TextBox x:Name="BackgroundUrlTextBox" TextChanged="BackgroundUrl_Changed" />
                                    <TextBlock Text="支持图片链接和直接返回图片的 API，例如 https://acg.neko-arc.top/api.php" Style="{StaticResource FieldHint}" />
                                    <TextBlock x:Name="BackgroundUrlError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel x:Name="BackgroundRotationPanel" Visibility="Collapsed">
                                    <Border Height="1" Background="{DynamicResource PanelBorderBrush}" Margin="0,20" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="不透明度" Style="{StaticResource FieldLabel}" />
                                        <TextBlock x:Name="BackgroundOpacityText" Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}" />
                                    </Grid>
                                    <Slider x:Name="BackgroundOpacitySlider" Minimum="5" Maximum="100" Value="25" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,8,0,18" ValueChanged="BackgroundOpacity_Changed" />
                                    <WrapPanel>
                                        <CheckBox x:Name="BackgroundAutoSwitchCheck" Content="自动切换背景" Checked="BackgroundRotation_Changed" Unchecked="BackgroundRotation_Changed" Margin="0,0,24,8" />
                                        <CheckBox x:Name="BackgroundShuffleCheck" Content="随机顺序" Checked="BackgroundRotation_Changed" Unchecked="BackgroundRotation_Changed" Margin="0,0,0,8" />
                                    </WrapPanel>
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="切换间隔（秒）" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBox x:Name="BackgroundIntervalTextBox" Grid.Column="1" TextChanged="BackgroundInterval_Changed" PreviewTextInput="MemoryTextBox_PreviewTextInput" />
                                        <Button Grid.Column="3" Content="切换背景图片" Style="{StaticResource SecondaryButton}" Click="NextBackground_Click" />
                                    </Grid>
                                    <TextBlock x:Name="BackgroundIntervalError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="AppearanceStatus" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Version isolation -->
                        <Border x:Name="IsolationCard" Style="{StaticResource SettingsCard}" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xE8F1;" Style="{StaticResource SectionIcon}" />
                                    <StackPanel>
                                        <TextBlock Text="版本隔离" Style="{StaticResource SectionHeader}" />
                                        <TextBlock Text="控制实例是否使用独立的游戏目录" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <ComboBox x:Name="IsolationComboBox" Width="200" HorizontalAlignment="Left"
                                          SelectionChanged="IsolationComboBox_SelectionChanged" />
                                <TextBlock x:Name="IsolationHintText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,10,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="提示：更改版本隔离后，已有世界/配置不会自动迁移；模组实例 = 加载器非空且非原版。" FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Directory -->
                        <Border x:Name="DirectoryCard" Style="{StaticResource SettingsCard}" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xE80F;" Style="{StaticResource SectionIcon}" />
                                    <StackPanel>
                                        <TextBlock Text="启动器目录" Style="{StaticResource SectionHeader}" />
                                        <TextBlock Text="启动器自身的工作目录（只读）" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="启动器目录" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="RootPathText" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                                <Button x:Name="OpenRootButton" Content="打开根目录" MinWidth="120"
                                        HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="OpenRootButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Instance storage location -->
                        <Border x:Name="InstanceDirectoryCard" Style="{StaticResource SettingsCard}" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource SectionIcon}" />
                                    <StackPanel>
                                        <TextBlock Text="游戏目录" Style="{StaticResource SectionHeader}" />
                                        <TextBlock Text="已安装实例的存放目录，更改后将自动迁移" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="实例目录" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InstancesDirectoryTextBox" IsReadOnly="True" Grid.Column="0" Margin="0,0,8,0"
                                             TextChanged="InstancesDirectoryTextBox_TextChanged" />
                                    <Button x:Name="BrowseInstancesButton" Grid.Column="1" Content="浏览…" MinWidth="80"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BrowseInstancesButton_Click" />
                                </Grid>
                                <TextBlock x:Name="InstancesDirectoryHintText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="InstancesDirectoryErrorText" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                           Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                                <Button x:Name="OpenInstancesButton" Content="打开实例目录" MinWidth="120"
                                        HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="OpenInstancesButton_Click" />
                                <TextBlock Text="提示：更改存放位置后，已有实例将被迁移；出现名称冲突时可手动重命名，未处理时自动追加 -2、(2) 等后缀。" FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Auto-update packs -->
                        <Border x:Name="PackUpdateCard" Style="{StaticResource SettingsCard}" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource SectionIcon}" />
                                    <StackPanel>
                                        <TextBlock Text="启动前自动更新整合包" Style="{StaticResource SectionHeader}" />
                                        <TextBlock Text="启动服务器整合包实例前检查并下载新 revision；关闭后直接启动已安装版本。" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <CheckBox x:Name="AutoUpdatePacksCheck" Checked="AutoUpdatePacks_Changed" Unchecked="AutoUpdatePacks_Changed" Content="启用自动更新" IsChecked="True" />
                                <TextBlock Text="关闭后可在资源站离线或更新失败时直接启动旧版本。" FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="LauncherUpdateCard" Style="{StaticResource SettingsCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="客户端更新" Style="{StaticResource SectionHeader}" />
                                <TextBlock x:Name="LauncherUpdateStatus" TextWrapping="Wrap" Margin="0,8,0,12"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="CheckLauncherUpdateButton" Content="检查更新" Style="{StaticResource SecondaryButton}"
                                            Click="CheckLauncherUpdate_Click" />
                                    <Button x:Name="InstallLauncherUpdateButton" Content="下载并安装" IsEnabled="False" Margin="12,0,0,0"
                                            Style="{StaticResource PrimaryButton}" Click="InstallLauncherUpdate_Click" />
                                    <Button x:Name="CancelLauncherUpdateButton" Content="取消下载" Visibility="Collapsed" Margin="12,0,0,0"
                                            Style="{StaticResource SecondaryButton}" Click="CancelLauncherUpdate_Click" />
                                </StackPanel>
                                <ProgressBar x:Name="LauncherUpdateProgress" Visibility="Collapsed" Maximum="100" Height="5" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>
        </Grid>


        <Border x:Name="PreferenceNotice" Grid.Row="1" Grid.Column="1" Panel.ZIndex="150" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right" MaxWidth="520" Margin="20" Padding="14,10" CornerRadius="4" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SettingsStatusText" MaxWidth="380" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="RetryPreferenceButton" Content="重试" Visibility="Collapsed" Margin="12,0,0,0" Style="{StaticResource SecondaryButton}" Click="RetryPreference_Click" />
            </StackPanel>
        </Border>

        <!-- ===================== In-main create-instance flow ===================== -->
        <local:CreateInstanceView x:Name="CreateInstanceView" Grid.Row="1" Grid.Column="1"
                                  Visibility="Collapsed" Panel.ZIndex="100" />
    </Grid>
</Window>
