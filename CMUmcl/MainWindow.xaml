<Window x:Class="CMUmcl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CMUmcl"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        Loaded="Window_Loaded">
    <Window.Resources>

        <!-- ============ Local brushes (do not depend on App changes) ============ -->
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#334C9EEB" />
        <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="PressedBrush" Color="#26000000" />

        <!-- ============ Navigation ============ -->
        <!-- Code-behind swaps these via FindResource("NavItem") / FindResource("NavItemActive"). -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Grid>
                                <Border x:Name="indicator" Width="3" CornerRadius="1.5"
                                        HorizontalAlignment="Left" Margin="0,9"
                                        Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                <Border x:Name="overlay" Background="Transparent" CornerRadius="10" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="overlay" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="overlay" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Active">
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItemActive" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Tag" Value="Active" />
        </Style>

        <!-- ============ Buttons ============ -->
        <ControlTemplate x:Key="ModernButtonTemplate" TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
                <Grid>
                    <Border x:Name="overlay" Background="Transparent" CornerRadius="8" />
                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="overlay" Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="overlay" Property="Background" Value="{StaticResource PressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource ModernButtonTemplate}" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource ModernButtonTemplate}" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource ModernButtonTemplate}" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PanelBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PanelBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Cards ============ -->
        <Style x:Key="PackCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource PackCard}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="20,18" />
        </Style>

        <!-- ============ Chips / tags ============ -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <Style x:Key="ChipAccent" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" />
        </Style>

        <!-- ============ Typography ============ -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="SectionIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ============ TextBox ============ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ ComboBox ============ -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0,4,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MaxDropDownHeight" Value="280" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="border" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" />

                            <ToggleButton x:Name="toggleButton" Grid.Column="1"
                                          Width="34" Background="Transparent" BorderThickness="0"
                                          ClickMode="Press" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <TextBlock x:Name="arrow" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="arrow" Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="contentPresenter" Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              IsHitTestVisible="False" />

                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                     Margin="{TemplateBinding Padding}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{StaticResource TextBrush}"
                                     VerticalContentAlignment="Center" VerticalAlignment="Center"
                                     HorizontalAlignment="Left"
                                     Visibility="Hidden" />

                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Border x:Name="dropDownBorder" Margin="0,4,0,0"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="contentPresenter" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ RadioButton ============ -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse x:Name="ring" Stroke="{StaticResource PanelBorderBrush}"
                                         StrokeThickness="1.5" Fill="{StaticResource BgBrush}" />
                                <Ellipse x:Name="dot" Width="8" Height="8"
                                         Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ ProgressBar ============ -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,22,20,18">
                    <Border Width="42" Height="42" CornerRadius="11"
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CMUmcl" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="CSU-MC" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Nav -->
                <StackPanel Grid.Row="1" Margin="12,4,12,0">
                    <Button x:Name="PacksNavButton" Style="{StaticResource NavItemActive}" Click="PacksNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Width="22" />
                            <TextBlock Text="整合包" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="InstancesNavButton" Style="{StaticResource NavItem}" Click="InstancesNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Width="22" />
                            <TextBlock Text="实例" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavItem}" Click="SettingsNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Width="22" />
                            <TextBlock Text="设置" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Account card -->
                <Border Grid.Row="3" Background="Transparent"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0"
                        Padding="16,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="已登录" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="AccountNameText" Text="" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button x:Name="LogoutButton" Grid.Column="2" Content="退出登录" VerticalAlignment="Center"
                                Style="{StaticResource GhostButton}" Click="LogoutButton_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== Main ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="28,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitleText" Text="服务器整合包" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="HeaderStatusText" Text=""
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NewInstanceButton" Margin="0,0,10,0"
                                Style="{StaticResource PrimaryButton}" Click="NewInstanceButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="新建实例" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButton}"
                                Click="RefreshButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="刷新" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1">

                <!-- ============ 服务器整合包 page ============ -->
                <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,22">
                        <ItemsControl x:Name="CardsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PackCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Icon -->
                                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                                                    Background="{StaticResource AccentSoftBrush}"
                                                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" Margin="16,0,20,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="16"
                                                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Style="{StaticResource ChipAccent}" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding RevisionText}" FontSize="11"
                                                                   Foreground="{StaticResource AccentBrush}" />
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{Binding Description}" FontSize="13"
                                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                           Margin="0,8,0,0" />

                                                <WrapPanel Margin="0,10,0,0">
                                                    <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                                        <TextBlock Text="{Binding GameText}" FontSize="11"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                                        <TextBlock Text="{Binding ServerText}" FontSize="11"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                                        <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                    </Border>
                                                </WrapPanel>

                                                <TextBlock Text="{Binding LoaderNote}" FontSize="12"
                                                           Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasLoaderNote, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>

                                            <!-- Status + actions -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           HorizontalAlignment="Right" Margin="0,0,0,10"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="230" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="查看实例"
                                                            Visibility="{Binding IsViewInstancesVisible, Converter={StaticResource BoolToVisibility}}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            MinWidth="96" Margin="0,0,10,0"
                                                            Click="ViewInstancesButton_Click" />
                                                    <Button Content="{Binding ButtonText, Mode=OneWay}"
                                                            IsEnabled="{Binding ButtonEnabled, Mode=OneWay}"
                                                            Visibility="{Binding IsInstallVisible, Converter={StaticResource BoolToVisibility}}"
                                                            Style="{StaticResource PrimaryButton}"
                                                            MinWidth="120"
                                                            Click="InstallButton_Click" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Progress -->
                                            <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0"
                                                         Visibility="{Binding IsProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding ProgressValue, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Packs overlay states -->
                <StackPanel x:Name="EmptyStateText" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                               Foreground="{StaticResource PanelBorderBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="暂无服务器整合包。" Foreground="{StaticResource MutedTextBrush}" FontSize="15"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="点击右上角「刷新」重新加载" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.7" />
                </StackPanel>

                <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressBar Width="160" Height="4" IsIndeterminate="True" />
                    <TextBlock Text="正在获取服务器整合包…" Foreground="{StaticResource MutedTextBrush}" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>

                <StackPanel x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed" MaxWidth="520">
                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource ErrorBrush}"
                            HorizontalAlignment="Center" Opacity="0.15">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{StaticResource ErrorBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="ErrorText" Text="" Foreground="{StaticResource ErrorBrush}" FontSize="14"
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <Button x:Name="RetryButton" Content="重试" MinWidth="100"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0"
                            Click="RefreshButton_Click" />
                </StackPanel>

                <!-- ============ 实例 page ============ -->
                <ScrollViewer x:Name="InstancesScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="28,22">
                        <ItemsControl x:Name="InstancesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PackCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Icon -->
                                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                                                    Background="{StaticResource AccentSoftBrush}"
                                                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" Margin="16,0,20,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="16"
                                                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Style="{StaticResource ChipAccent}" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding SourceText}" FontSize="11"
                                                                   Foreground="{StaticResource AccentBrush}" />
                                                    </Border>
                                                </Grid>

                                                <Border Style="{StaticResource Chip}" Margin="0,10,0,0" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding GameText}" FontSize="11"
                                                               Foreground="{StaticResource MutedTextBrush}" />
                                                </Border>

                                                <TextBlock Text="{Binding PathText}" FontSize="12"
                                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Content="{Binding ButtonText, Mode=OneWay}"
                                                        IsEnabled="{Binding ButtonEnabled, Mode=OneWay}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        MinWidth="110" Click="LaunchButton_Click" />
                                                <Button Content="打开目录" MinWidth="90" Margin="10,0,0,0"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="OpenInstanceDirButton_Click" />
                                                <Button Content="实例设置" MinWidth="90" Margin="10,0,0,0"
                                                        Style="{StaticResource SecondaryButton}" IsEnabled="False" />
                                            </StackPanel>

                                            <!-- Progress -->
                                            <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0"
                                                         Visibility="{Binding IsProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding ProgressValue, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Instances empty state -->
                <StackPanel x:Name="InstancesEmptyStateText" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                               Foreground="{StaticResource PanelBorderBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="暂无已安装实例。" Foreground="{StaticResource MutedTextBrush}" FontSize="15"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="点击右上角新建实例" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.7" />
                </StackPanel>

                <!-- ============ 设置 page ============ -->
                <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="28,22" MaxWidth="820">

                        <!-- Java -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xE756;" Style="{StaticResource SectionIcon}" />
                                    <StackPanel>
                                        <TextBlock Text="Java" Style="{StaticResource SectionHeader}" />
                                        <TextBlock Text="选择 Java 运行时：自动检测或手动指定 javaw.exe 路径" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <RadioButton x:Name="JavaAutoRadio" Content="自动选择" GroupName="JavaMode" Checked="JavaMode_Checked" />
                                <RadioButton x:Name="JavaManualRadio" Content="手动指定" GroupName="JavaMode" Checked="JavaMode_Checked" Margin="0,10,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="JavaPathTextBox" Grid.Column="0" Margin="0,0,8,0"
                                             TextChanged="JavaPathTextBox_TextChanged" />
                                    <Button x:Name="BrowseJavaButton" Grid.Column="1" Content="浏览…" MinWidth="80"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BrowseJavaButton_Click" />
                                </Grid>
                                <TextBlock x:Name="JavaDetectedText" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,10,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="JavaErrorText" FontSize="12" Foreground="{StaticResource ErrorBrush}"
                                           Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Memory -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xE950;" Style="{StaticResource SectionIcon}" />
                                    <StackPanel>
                                        <TextBlock Text="内存" Style="{StaticResource SectionHeader}" />
                                        <TextBlock Text="分配给 Minecraft 的最大内存（MB）" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="SystemMemoryText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="MemoryTextBox" Grid.Column="0" Width="140"
                                             PreviewTextInput="MemoryTextBox_PreviewTextInput" />
                                    <TextBlock Grid.Column="1" Text="MB" Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                                <TextBlock x:Name="MemoryErrorText" FontSize="12" Foreground="{StaticResource ErrorBrush}"
                                           Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Version isolation -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xE8F1;" Style="{StaticResource SectionIcon}" />
                                    <StackPanel>
                                        <TextBlock Text="版本隔离" Style="{StaticResource SectionHeader}" />
                                        <TextBlock Text="控制实例是否使用独立的游戏目录" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <ComboBox x:Name="IsolationComboBox" Width="200" HorizontalAlignment="Left"
                                          SelectionChanged="IsolationComboBox_SelectionChanged" />
                                <TextBlock x:Name="IsolationHintText" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,10,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="提示：更改版本隔离后，已有世界/配置不会自动迁移；模组实例 = 加载器非空且非原版。" FontSize="12"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Directory -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xE80F;" Style="{StaticResource SectionIcon}" />
                                    <StackPanel>
                                        <TextBlock Text="目录" Style="{StaticResource SectionHeader}" />
                                        <TextBlock Text="启动器自身的工作目录（只读）" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="启动器根目录" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="RootPathText" FontSize="13" Foreground="{StaticResource TextBrush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                                <Button x:Name="OpenRootButton" Content="打开根目录" MinWidth="120"
                                        HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="OpenRootButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Instance storage location -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource SectionIcon}" />
                                    <StackPanel>
                                        <TextBlock Text="实例存放位置" Style="{StaticResource SectionHeader}" />
                                        <TextBlock Text="已安装实例的存放目录，更改后将自动迁移" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="实例目录" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InstancesDirectoryTextBox" Grid.Column="0" Margin="0,0,8,0"
                                             TextChanged="InstancesDirectoryTextBox_TextChanged" />
                                    <Button x:Name="BrowseInstancesButton" Grid.Column="1" Content="浏览…" MinWidth="80"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BrowseInstancesButton_Click" />
                                </Grid>
                                <TextBlock x:Name="InstancesDirectoryHintText" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="InstancesDirectoryErrorText" FontSize="12" Foreground="{StaticResource ErrorBrush}"
                                           Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                                <Button x:Name="OpenInstancesButton" Content="打开实例目录" MinWidth="120"
                                        HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="OpenInstancesButton_Click" />
                                <TextBlock Text="提示：更改存放位置后，已有实例将被迁移；出现名称冲突时可手动重命名，未处理时自动追加 -2、(2) 等后缀。" FontSize="12"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Save -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button x:Name="SaveSettingsButton" Content="保存设置" MinWidth="130"
                                    Style="{StaticResource PrimaryButton}" Click="SaveSettingsButton_Click" />
                            <TextBlock x:Name="SettingsStatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                                       VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
